{
  "name": "notedown",
  "productName": "Notedown",
  "version": "0.2.6",
  "description": "Notedown desktop Markdown notes app",
  "author": "Taewook Kwon (ImuruKevol) <kwon3286@season.co.kr>",
  "license": "MIT",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "electron": "electron .",
    "electron:dev": "NOTEDOWN_DEV_URL=http://localhost:4200 electron .",
    "test:electron": "node --test electron/*.test.cjs",
    "dist": "electron-builder",
    "dist:mac:arm64": "electron-builder --mac --arm64",
    "dist:mac:x64": "electron-builder --mac --x64",
    "dist:win:nsis": "electron-builder --win nsis --x64",
    "dist:requested": "npm run dist:mac:arm64 && npm run dist:mac:x64 && npm run dist:win:nsis"
  },
  "devDependencies": {
    "@angular/cli": "^21.0.0",
    "electron": "^42.3.0",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "com.notedown.app",
    "productName": "Notedown",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "asar": true,
    "directories": {
      "buildResources": "build-resources",
      "output": "dist"
    },
    "files": [
      "package.json",
      "electron/**/*",
      "bundle/www/**/*",
      "build-resources/**/*"
    ],
    "extraMetadata": {
      "name": "notedown",
      "productName": "Notedown",
      "main": "electron/main.cjs"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build-resources/icon.icns",
      "identity": "-",
      "target": [
        "pkg",
        "zip"
      ]
    },
    "pkg": {
      "installLocation": "/Applications",
      "scripts": "pkg-scripts"
    },
    "win": {
      "icon": "build-resources/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Notedown",
      "uninstallDisplayName": "Notedown",
      "include": "build-resources/installer.nsh"
    }
  }
}
